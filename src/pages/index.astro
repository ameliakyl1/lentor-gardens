---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import AboutAgent from "@/components/AboutAgent.astro";
import About from "@/components/About.astro";
import Location from "@/components/Location.astro";
import Price from "@/components/Price.astro";
import Floorplans from "@/components/Floorplans.astro";
import Brochure from "@/components/Brochure.astro";
import Gallery from "@/components/Gallery.astro";
import Developer from "@/components/Developer.astro";
import AboutThisWebsite from "@/components/AboutThisWebsite.astro";
import Faq from "@/components/Faq.astro";
import Contact from "@/components/Contact.astro";
import Footer from "@/components/Footer.astro";
import StickyMobileContactBar from "@/components/StickyMobileContactBar.astro";
import ConsentNotice from "@/components/ConsentNotice.astro";
import { project } from "@/data/project";
import { agent } from "@/data/agent";
import {
  buildRealEstateAgentSchema,
  buildFaqSchema,
  buildApartmentComplexSchema,
} from "@/utils/structuredData";

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
// Google cuts the search headline at roughly 60 characters. The project name leads so it
// survives that cut — it is the term buyers actually search. The agent name and CEA
// registration number stay inside the title, so identity is still declared before the page
// renders; the full disclosure remains in the notice bar, header, "About this website"
// section, FAQ and footer.
const title = `${project.general.projectName} | ${agent.fullName} ${agent.ceaRegistrationNumber}`;
// Meta descriptions are cut at roughly 155 characters. Lead with what a buyer is looking for
// and close with the independent-agent disclosure so it survives truncation.
const description = `Lentor Gardens Residences, ${project.general.districtShort}. 499 units, 2–4 bedrooms and strata terraces, 2 min walk to Lentor MRT. Price list on request. Independent agent site.`;
---

<BaseLayout
  title={title}
  description={description}
  structuredData={[
    buildRealEstateAgentSchema(canonicalUrl),
    buildFaqSchema(),
    buildApartmentComplexSchema(canonicalUrl),
  ]}
>
  <Header />
  <main id="main-content">
    <Hero />
    <AboutAgent />
    <About />
    <Location />
    <Price />
    <Floorplans />
    <Brochure />
    <Gallery />
    <Developer />
    <Faq />
    <AboutThisWebsite />
    <Contact />
  </main>
  <Footer />
  <StickyMobileContactBar />
  <ConsentNotice />
</BaseLayout>
