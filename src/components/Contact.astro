---
import { agent } from "@/data/agent";
import { project } from "@/data/project";

const whatsappUrl = `https://wa.me/${agent.whatsappNumber.replace(/[^\d]/g, "")}?text=${encodeURIComponent(
  project.contact.whatsappMessage
)}`;
---

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<section id="contact" class="bg-surface">
  <div class="container contact-grid">
    <div class="contact-intro reveal-on-scroll">
      <span class="section-eyebrow">Contact</span>
      <h2>Book a Showflat Appointment</h2>
      <p>
        Share a few details and Amelia will follow up to confirm a showflat viewing time, or
        answer any questions about {project.general.projectName}. You can also reach out directly
        by phone or WhatsApp.
      </p>

      <div class="contact-direct">
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-accent" data-track="click_whatsapp">
          WhatsApp {agent.displayName}
        </a>
        <a href={`tel:${agent.mobileNumber.replace(/\s/g, "")}`} class="btn btn-secondary" data-track="click_call">
          Call {agent.displayName}
        </a>
        <a href={`mailto:${agent.email}`} class="btn btn-secondary">Email</a>
      </div>

      <p class="response-note">
        Amelia typically responds to enquiries within one business day. This is not a guaranteed
        response time.
      </p>

      <div class="agent-credentials">
        <span class="credentials-label">Marketed by</span>
        <p class="credentials-name">{agent.fullName}</p>
        <p class="credentials-lines">
          Licensed Real Estate Salesperson<br />
          CEA Reg. No. <span class="credentials-reg">{agent.ceaRegistrationNumber}</span><br />
          {agent.estateAgencyName} · CEA Lic. No. {agent.estateAgencyLicenceNumber}
        </p>
        <a
          class="credentials-verify"
          href={agent.ceaVerificationUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Verify on CEA Public Register
        </a>
      </div>
    </div>

    <form id="enquiry-form" class="contact-form card reveal-on-scroll" novalidate>
      <div class="form-status" id="form-status" role="status" aria-live="polite"></div>

      <div class="form-field">
        <label class="form-label" for="fullName">Full Name</label>
        <input class="form-input" type="text" id="fullName" name="fullName" autocomplete="name" required />
        <p class="form-error" id="fullName-error" hidden></p>
      </div>

      <div class="form-field">
        <label class="form-label" for="mobileNumber">WhatsApp Number</label>
        <div class="phone-input">
          <span class="phone-prefix">+65 Singapore</span>
          <input
            class="form-input phone-number"
            type="tel"
            id="mobileNumber"
            name="mobileNumber"
            autocomplete="tel"
            placeholder="8123 4567"
            required
          />
        </div>
        <p class="form-error" id="mobileNumber-error" hidden></p>
      </div>

      <div class="form-field">
        <span class="form-label" id="unit-type-label">Preferred Unit Type</span>
        <div class="checkbox-grid" role="group" aria-labelledby="unit-type-label">
          {project.unitTypes.map((u) => (
            <label class="checkbox-tile">
              <input type="checkbox" name="preferredUnitTypes" value={u.type} /> {u.type}
            </label>
          ))}
        </div>
      </div>

      <div class="form-field">
        <span class="form-label" id="interests-label">I'm Interested In</span>
        <div class="checkbox-stack" role="group" aria-labelledby="interests-label">
          <label class="checkbox-tile">
            <input type="checkbox" name="interests" value="Arrange Showflat Viewing" /> Arrange Showflat Viewing
          </label>
          <label class="checkbox-tile">
            <input type="checkbox" name="interests" value="Request for Brochure & Floorplans" /> Request for Brochure
            & Floorplans
          </label>
          <label class="checkbox-tile">
            <input type="checkbox" name="interests" value="Request for Latest Pricelist & Available Units" /> Request
            for Latest Pricelist & Available Units
          </label>
        </div>
      </div>

      <div class="form-field">
        <label class="form-label" for="message">Message (optional)</label>
        <textarea class="form-textarea" id="message" name="message"></textarea>
      </div>

      <!-- Honeypot: hidden from real users, catches basic bots. Never rename to something obvious like "honeypot". -->
      <div class="honeypot-field" aria-hidden="true">
        <label for="companyWebsite">Leave this field blank</label>
        <input type="text" id="companyWebsite" name="companyWebsite" tabindex="-1" autocomplete="off" />
      </div>

      <div
        class="cf-turnstile"
        data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}
        data-theme="light"
      >
      </div>

      <div class="checkbox-field">
        <input type="checkbox" id="consent" name="consent" required />
        <label for="consent">
          By submitting this enquiry, I consent to the collection and use of my personal data for
          the purpose of this property enquiry. I have read the <a href="/privacy">Privacy Policy</a>
          and <a href="/terms">Terms & Conditions</a>, and I consent to {agent.fullName} of
          {agent.estateAgencyName} contacting me regarding this enquiry in accordance with
          Singapore's PDPA.
        </label>
      </div>
      <p class="form-error" id="consent-error" hidden></p>

      <button type="submit" class="btn btn-accent btn-block" id="submit-btn">
        <span id="submit-btn-label">Submit Enquiry</span>
      </button>
    </form>
  </div>
</section>

<style>
  /* `align-items: stretch` (the default) lets the intro column match the form's height, which is
     what allows the credentials block below to push itself to the bottom with margin-top: auto
     and sit level with the lower part of the form, rather than floating mid-column. */
  .contact-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: var(--space-12); }
  @media (max-width: 900px) { .contact-grid { grid-template-columns: 1fr; } }

  .contact-intro { display: flex; flex-direction: column; }
  .contact-direct { display: flex; gap: var(--space-4); flex-wrap: wrap; margin: var(--space-6) 0 var(--space-4); }
  .response-note { font-size: 0.85rem; color: var(--color-ink-soft); }
  /* Sits at the foot of the intro column as a distinct "who is marketing this" signature block,
     mirroring the reference layout. margin-top: auto pins it to the bottom of the flex column. */
  .agent-credentials {
    margin-top: auto;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  .credentials-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-3);
  }
  .credentials-name {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.2;
    margin: 0 0 var(--space-2);
  }
  .credentials-lines {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-ink-soft);
    margin: 0 0 var(--space-3);
    max-width: none;
  }
  .credentials-reg { color: var(--color-accent); }
  .credentials-verify {
    font-size: 1rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 900px) {
    /* No second column to align against once stacked, so the auto-margin has nothing to push
       against — restore a normal gap instead. */
    .agent-credentials { margin-top: var(--space-8); }
  }
  .phone-input { display: flex; border: 1px solid var(--color-border); border-radius: var(--radius-sm); overflow: hidden; }
  .phone-prefix { display: flex; align-items: center; padding: 0 var(--space-3); background: var(--color-border); color: var(--color-ink); font-size: 0.9rem; white-space: nowrap; border-right: 1px solid var(--color-border); }
  .phone-number { border: none; border-radius: 0; flex: 1; }
  .checkbox-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: var(--space-3); }
  .checkbox-stack { display: flex; flex-direction: column; gap: var(--space-3); }
  .checkbox-tile { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-3); border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 0.92rem; cursor: pointer; }
  .checkbox-tile input { flex-shrink: 0; }
  .form-status:not(:empty) { padding: var(--space-3) var(--space-4); border-radius: var(--radius-sm); margin-bottom: var(--space-4); font-size: 0.9rem; }
  .form-status[data-state="success"] { background: color-mix(in srgb, var(--color-success) 12%, transparent); color: var(--color-success); }
  .form-status[data-state="error"] { background: color-mix(in srgb, var(--color-error) 12%, transparent); color: var(--color-error); }
</style>

<script>
  import { validateEnquiry, type EnquiryFormData } from "@/utils/validation";
  import { project } from "@/data/project";

  const form = document.getElementById("enquiry-form") as HTMLFormElement | null;
  const statusEl = document.getElementById("form-status");
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
  const submitLabel = document.getElementById("submit-btn-label");
  let started = false;

  function getAttribution() {
    const params = new URLSearchParams(window.location.search);
    const get = (k: string) => params.get(k);
    return {
      utm_source: get("utm_source"),
      utm_medium: get("utm_medium"),
      utm_campaign: get("utm_campaign"),
      utm_term: get("utm_term"),
      utm_content: get("utm_content"),
      gclid: get("gclid"),
      gbraid: get("gbraid"),
      wbraid: get("wbraid"),
      landingPageUrl: window.location.href,
      referrer: document.referrer || null,
    };
  }

  function showFieldError(field: string, message?: string) {
    const input = document.getElementById(field);
    const errorEl = document.getElementById(`${field}-error`);
    if (input) input.setAttribute("aria-invalid", message ? "true" : "false");
    if (errorEl) {
      errorEl.textContent = message ?? "";
      errorEl.hidden = !message;
    }
  }

  form?.addEventListener(
    "focusin",
    () => {
      if (!started) {
        started = true;
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: "form_start" });
      }
    },
    { once: true }
  );

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form || !submitBtn || !submitLabel) return;

    const formData = new FormData(form);
    const data: EnquiryFormData = {
      fullName: String(formData.get("fullName") ?? ""),
      mobileNumber: String(formData.get("mobileNumber") ?? ""),
      propertyInterest: project.general.projectName,
      preferredUnitTypes: formData.getAll("preferredUnitTypes").map(String),
      interests: formData.getAll("interests").map(String),
      message: String(formData.get("message") ?? ""),
      consent: formData.get("consent") === "on",
      honeypot: String(formData.get("companyWebsite") ?? ""),
    };

    ["fullName", "mobileNumber", "consent"].forEach((f) => showFieldError(f));

    const errors = validateEnquiry(data);
    const turnstileToken = String(formData.get("cf-turnstile-response") ?? "");
    if (Object.keys(errors).length > 0 && !errors.honeypot) {
      Object.entries(errors).forEach(([field, message]) => showFieldError(field, message));
      if (statusEl) {
        statusEl.dataset.state = "error";
        statusEl.textContent = "Please correct the highlighted fields and try again.";
      }
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: "form_error" });
      return;
    }

    if (!turnstileToken && !errors.honeypot) {
      if (statusEl) {
        statusEl.dataset.state = "error";
        statusEl.textContent = "Please complete the verification checkbox before submitting.";
      }
      return;
    }

    submitBtn.disabled = true;
    submitLabel.textContent = "Submitting…";
    if (statusEl) {
      statusEl.dataset.state = "";
      statusEl.textContent = "";
    }

    try {
      const response = await fetch("/api/enquiry", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ ...data, turnstileToken, attribution: getAttribution() }),
      });

      if (errors.honeypot) {
        // Bots see a normal-looking success without a real submission having occurred.
        window.location.href = "/thank-you";
        return;
      }

      if (!response.ok) throw new Error("Submission failed");

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: "form_submit" });
      window.dataLayer.push({ event: "generate_lead" });
      window.location.href = "/thank-you";
    } catch {
      if (statusEl) {
        statusEl.dataset.state = "error";
        statusEl.textContent =
          "Something went wrong sending your enquiry. Please try again, or contact Amelia directly by phone or WhatsApp.";
      }
      window.turnstile?.reset();
      submitBtn.disabled = false;
      submitLabel.textContent = "Submit Enquiry";
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: "form_error" });
    }
  });

  declare global {
    interface Window {
      turnstile?: { reset: (widgetId?: string) => void };
    }
  }
</script>
