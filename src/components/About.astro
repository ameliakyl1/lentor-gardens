---
import { project } from "@/data/project";
const { general, content } = project;

// Converts *emphasized* segments to <strong> for paragraphs with markup, escaping the rest.
function renderEmphasis(text: string): string {
  const escape = (s: string) =>
    s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  return text
    .split(/(\*[^*]+\*)/g)
    .map((part) =>
      part.startsWith("*") && part.endsWith("*")
        ? `<strong>${escape(part.slice(1, -1))}</strong>`
        : escape(part)
    )
    .join("");
}

const quickFacts = [
  { label: "Developer", value: general.developerShortName },
  { label: "Location", value: general.streetAddress },
  { label: "District", value: general.district },
  { label: "Tenure", value: general.tenure },
  { label: "Total Units", value: general.numberOfUnits },
  { label: "No. of Carpark Lots", value: `${general.numberOfCarparkLots} Lots` },
  { label: "Unit Types", value: general.unitTypesSummary },
  { label: "Expected TOP", value: general.expectedTOP },
  { label: "Project Status", value: general.projectStatus },
];
---

<section id="about" class="bg-surface">
  <div class="container">
    <div class="section-heading reveal-on-scroll">
      <span class="section-eyebrow">About the Project</span>
      <h2>About {general.projectName}</h2>
    </div>

    <div class="about-grid">
      <div class="about-copy reveal-on-scroll">
        {content.aboutOverview.split("\n\n").map((para) => <p set:html={renderEmphasis(para)} />)}
      </div>

      <aside class="quick-facts card reveal-on-scroll" aria-label="Quick facts">
        <h3>{general.projectName} — Project Information</h3>
        <dl>
          {quickFacts.map((fact) => (
            <div class="quick-fact-row">
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
        <p class="quick-facts-note">Facts shown are subject to final verification against official developer documents.</p>
      </aside>
    </div>
  </div>
</section>

<style>
  /*
    Single column: the facts card previously sat in a ~380px side column, which forced every
    value onto 3–4 wrapped lines and made the card taller than the article beside it. Full width
    lets each fact read as one horizontal label → value row instead.
  */
  .about-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-12); }

  .quick-facts { padding: var(--space-8); }
  .quick-facts h3 { margin-bottom: var(--space-6); line-height: 1.3; }

  /* Two columns of rows on wide screens, one on narrow — auto-fit collapses it for us. */
  .quick-facts dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 0 var(--space-12);
    margin: 0;
  }
  .quick-fact-row {
    display: grid;
    grid-template-columns: minmax(130px, 0.5fr) 1fr;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .quick-fact-row dt {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }
  .quick-fact-row dd {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-ink);
  }

  /*
    Below ~560px there isn't room for a label column and a readable value column side by side —
    the longest value ("502 in total — 499 residential units…") would drop to ~160px and wrap to
    six lines. Stack instead, so the value still gets the card's full width.
  */
  @media (max-width: 560px) {
    .quick-facts { padding: var(--space-6); }
    .quick-fact-row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
      padding: var(--space-3) 0;
    }
  }
  /* No border-top here: every fact row already ends in a rule, so adding one would read as a
     double line under the last row. */
  .quick-facts-note {
    font-size: 0.78rem;
    color: var(--color-ink-soft);
    margin: var(--space-6) 0 0;
  }
</style>
