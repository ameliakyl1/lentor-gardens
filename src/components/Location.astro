---
import { project } from "@/data/project";
const { location, content } = project;

const amenityCategories = Array.from(new Set(location.amenities.map((a) => a.category)));
---

<section id="location" class="bg-surface">
  <div class="container">
    <div class="location-intro">
      <div class="section-heading reveal-on-scroll">
        <span class="section-eyebrow">Location</span>
        <h2>Location &amp; Connectivity</h2>
        <p>{content.locationAnalysis}</p>
      </div>

      <div class="location-map card reveal-on-scroll">
        <button type="button" class="map-trigger" id="map-trigger" aria-label="View larger map">
          <img
            src={location.mapImage.src}
            alt={location.mapImage.alt}
            width={location.mapImage.width}
            height={location.mapImage.height}
            loading="lazy"
            decoding="async"
          />
          <span class="map-zoom-hint">Tap to enlarge</span>
        </button>
        {location.interactiveMapUrl && location.interactiveMapUrl !== "[GOOGLE MAPS URL]" && (
          <a
            href={location.interactiveMapUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary"
          >
            Open Interactive Map
          </a>
        )}
      </div>
    </div>

    <!--
      One presentation at every width: filter chips over an always-visible card grid. Mobile
      previously swapped in a collapsed category accordion — a genuinely different UI from the
      desktop grid — which was changed so the two views read as the same design. The filter
      chips carry the load the accordion used to: tapping a category narrows 15+ amenities to a
      handful instead of hiding them behind a disclosure.
    -->
    <div class="amenity-view">
      <div class="filter-bar" role="group" aria-label="Filter nearby amenities by category">
        <button type="button" class="filter-chip is-active" data-filter="all">All</button>
        {amenityCategories.map((cat) => (
          <button type="button" class="filter-chip" data-filter={cat}>{cat}</button>
        ))}
      </div>

      <div class="amenity-grid">
        {location.amenities.map((item) => (
          <div class="amenity-card reveal-on-scroll" data-category={item.category}>
            <span class="amenity-eyebrow">{item.category} · {item.distance}</span>
            <span class="amenity-divider" aria-hidden="true"></span>
            <h3 class="amenity-name">{item.name}</h3>
            <p class="amenity-desc">{item.description}</p>
          </div>
        ))}
      </div>
    </div>


    <p class="disclaimer-box">
      School names and distances are indicative and approximate. Proximity does not confer any
      priority, eligibility or guarantee of admission — please verify directly with the school
      and the Ministry of Education. All distances and travel times are estimates, subject to
      change, and do not guarantee future transport completion or capital appreciation.
    </p>
  </div>

  <div
    class="map-modal"
    id="map-modal"
    role="dialog"
    aria-modal="true"
    aria-label={location.mapImage.alt}
    hidden
  >
    <div class="map-modal-backdrop" data-map-close></div>
    <button type="button" class="modal-close" data-map-close aria-label="Close map">✕</button>
    <img
      src={location.mapImage.src}
      alt={location.mapImage.alt}
      width={location.mapImage.width}
      height={location.mapImage.height}
    />
  </div>
</section>

<style>
  .location-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
    margin-bottom: var(--space-8);
  }
  @media (max-width: 900px) {
    .location-intro { grid-template-columns: 1fr; gap: var(--space-6); }
  }
  .location-intro .section-heading { margin-bottom: 0; }

  .location-map { padding: var(--space-4); max-width: 560px; }
  @media (max-width: 900px) { .location-map { max-width: none; } }
  .map-trigger {
    display: block;
    position: relative;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    margin-bottom: var(--space-4);
  }
  .map-trigger img { border-radius: var(--radius-sm); width: 100%; height: auto; }
  .map-zoom-hint {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    background: rgba(14, 20, 15, 0.72);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 4px 10px;
    border-radius: 999px;
  }

  .amenity-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }
  @media (max-width: 900px) { .amenity-grid { grid-template-columns: 1fr 1fr; } }
  /* One column below 640px — two columns leaves each card under ~150px, too narrow for the
     name plus description to sit comfortably. */
  @media (max-width: 640px) { .amenity-grid { grid-template-columns: 1fr; } }

  /* Keep the chips on a single scrollable row on narrow screens rather than letting them wrap
     into a three-row block that pushes the grid off-screen. */
  @media (max-width: 640px) {
    .amenity-view .filter-bar {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      margin-inline: calc(-1 * var(--space-4));
      padding-inline: var(--space-4);
    }
    .amenity-view .filter-bar::-webkit-scrollbar { display: none; }
    .amenity-view .filter-chip { flex: 0 0 auto; }
  }

  .amenity-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
  }
  .amenity-eyebrow {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .amenity-divider {
    display: block;
    width: 32px;
    height: 2px;
    background: var(--color-border);
    margin: var(--space-4) 0;
  }
  .amenity-name { margin-bottom: var(--space-2); font-size: 1.1rem; }
  .amenity-desc { margin: 0; font-size: 0.9rem; color: var(--color-ink-soft); line-height: 1.5; }

  .map-modal { position: fixed; inset: 0; z-index: 300; display: flex; align-items: center; justify-content: center; padding: var(--space-6); }
  .map-modal[hidden] { display: none; }
  .map-modal-backdrop { position: absolute; inset: 0; background: rgba(14, 20, 15, 0.75); }
  .map-modal img {
    position: relative;
    max-width: 100%;
    max-height: 90vh;
    width: auto;
    border-radius: var(--radius-sm);
  }
  .modal-close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    background: rgba(255, 255, 255, 0.9);
    border: none;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    cursor: pointer;
    z-index: 1;
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>(".filter-bar .filter-chip");
  const amenityCards = document.querySelectorAll<HTMLElement>(".amenity-view .amenity-card");

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      chips.forEach((c) => c.classList.remove("is-active"));
      chip.classList.add("is-active");
      const filter = chip.dataset.filter;
      amenityCards.forEach((card) => {
        const show = filter === "all" || card.dataset.category === filter;
        card.style.display = show ? "" : "none";
      });
    });
  });

  const trigger = document.getElementById("map-trigger");
  const modal = document.getElementById("map-modal");
  let lastFocused: HTMLElement | null = null;

  function openModal() {
    if (!modal) return;
    lastFocused = document.activeElement as HTMLElement;
    modal.hidden = false;
    modal.querySelector<HTMLButtonElement>(".modal-close")?.focus();
    document.addEventListener("keydown", onKeydown);
  }

  function closeModal() {
    if (!modal) return;
    modal.hidden = true;
    document.removeEventListener("keydown", onKeydown);
    lastFocused?.focus();
  }

  function onKeydown(event: KeyboardEvent) {
    if (event.key === "Escape") closeModal();
  }

  trigger?.addEventListener("click", openModal);
  modal?.querySelectorAll("[data-map-close]").forEach((el) => el.addEventListener("click", closeModal));
</script>
