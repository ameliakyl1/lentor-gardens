---
import { project } from "@/data/project";
import { agent } from "@/data/agent";
const { media, general } = project;

const brochureMessage = `Hi Amelia, I'm interested in ${general.projectName} and would like to request the latest brochure.`;
const whatsappUrl = `https://wa.me/${agent.whatsappNumber.replace(/[^\d]/g, "")}?text=${encodeURIComponent(brochureMessage)}`;
---

<section id="brochure" class="bg-surface">
  <div class="container brochure-stack">
    <div class="brochure-cover card reveal-on-scroll">
      <img
        src={media.brochureCover.src}
        alt={media.brochureCover.alt}
        width={media.brochureCover.width}
        height={media.brochureCover.height}
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="brochure-copy reveal-on-scroll">
      <span class="section-eyebrow">Brochure</span>
      <h2>{general.projectName} E-Brochure</h2>

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-accent"
        data-track="request_brochure"
      >
        Request Brochure
      </a>
    </div>
  </div>
</section>

<style>
  .brochure-stack { max-width: 800px; margin-inline: auto; text-align: center; }
  .brochure-cover { padding: var(--space-2); margin-bottom: var(--space-8); }
  .brochure-cover img { width: 100%; height: auto; display: block; border-radius: var(--radius-sm); }
  .brochure-copy h2 { margin-bottom: var(--space-6); }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-track="request_brochure"]').forEach((el) => {
    el.addEventListener("click", () => {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: "request_brochure" });
    });
  });
</script>
