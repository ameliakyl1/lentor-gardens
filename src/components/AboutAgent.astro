---
import { agent } from "@/data/agent";
import { project } from "@/data/project";
---

<!--
  Who the visitor is dealing with, placed directly after the hero rather than near the footer.

  Google's Unacceptable business practices guidance asks advertisers to "describe your business on
  your website ... like an 'About us' page" and to "use your own branding". The operator disclosure
  further down states what this site is *not* (the developer's). This section states what it *is*:
  a licensed salesperson's page about a project she markets. Those are different jobs, which is why
  this is separate from AboutThisWebsite.astro rather than merged into it.

  Everything here must be verifiable. No sales figures, awards, years of experience or rankings —
  the CEA register and the Huttons profile are the only claims made, and both are linked.
-->
<section id="about-agent" class="about-agent">
  <div class="container about-agent-inner">
    <span class="section-eyebrow">Your agent</span>

    <div class="about-agent-grid">
      {agent.profileImage && (
        <img
          src={agent.profileImage.src}
          alt={agent.profileImage.alt}
          width={agent.profileImage.width}
          height={agent.profileImage.height}
          class="about-agent-photo"
          loading="lazy"
          decoding="async"
        />
      )}

      <div class="about-agent-body">
        <h2>{agent.fullName}</h2>
        <p class="about-agent-role">
          {agent.jobTitle} · {agent.estateAgencyName}
        </p>
        <p class="about-agent-cea">
          CEA Reg. No. {agent.ceaRegistrationNumber} · Agency Licence No. {agent.estateAgencyLicenceNumber}
        </p>

        <p class="about-agent-bio">{agent.shortBio}</p>

        <p class="about-agent-scope">
          I market {project.general.projectName} as an independent salesperson. I am not the
          developer and this is not the developer's website — my role is to help you evaluate the
          project on the facts and to arrange a showflat viewing.
        </p>

        <ul class="about-agent-specialisations">
          {agent.specialisations.map((item) => <li>{item}</li>)}
        </ul>

        <div class="about-agent-contact">
          <a href={`tel:${agent.mobileNumber.replace(/\s/g, "")}`}>{agent.mobileNumber}</a>
          <span aria-hidden="true">·</span>
          <a href={`mailto:${agent.email}`}>{agent.email}</a>
          <span aria-hidden="true">·</span>
          <a href="/about-amelia">More about me</a>
          <span aria-hidden="true">·</span>
          <a href={agent.ceaVerificationUrl} target="_blank" rel="noopener noreferrer">Verify on CEA Register</a>
          <span aria-hidden="true">·</span>
          <a href={agent.huttonsAgentProfileUrl} target="_blank" rel="noopener noreferrer">Huttons profile</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-agent {
    padding-block: var(--space-10);
    border-bottom: 1px solid var(--color-border);
  }
  .about-agent .section-eyebrow { display: block; margin-bottom: var(--space-5); }

  .about-agent-grid {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: var(--space-8);
    align-items: start;
  }
  .about-agent-photo {
    width: 180px;
    height: 180px;
    object-fit: cover;
    border-radius: 2px;
    display: block;
  }

  .about-agent-body h2 { margin: 0 0 var(--space-2); line-height: 1.15; }

  /* Role and registration sit immediately under the name, at body size — the identity is the
     point of this section, so none of it is set smaller than the surrounding copy. */
  .about-agent-role {
    margin: 0 0 var(--space-1);
    font-size: 1rem;
    color: var(--color-ink);
  }
  .about-agent-cea {
    margin: 0 0 var(--space-5);
    font-size: 1rem;
    color: var(--color-ink-soft);
  }

  .about-agent-bio,
  .about-agent-scope {
    margin: 0 0 var(--space-4);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-ink-soft);
    max-width: 60ch;
  }
  .about-agent-scope { color: var(--color-ink); }

  .about-agent-specialisations {
    margin: 0 0 var(--space-5);
    padding-left: var(--space-5);
    color: var(--color-ink-soft);
    font-size: 1rem;
    line-height: 1.7;
  }
  .about-agent-specialisations li { margin-bottom: var(--space-1); }

  .about-agent-contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    align-items: center;
    font-size: 1rem;
  }
  .about-agent-contact a {
    color: var(--color-accent-strong);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .about-agent-contact span { color: var(--color-border); }

  @media (max-width: 700px) {
    .about-agent { padding-block: var(--space-8); }
    .about-agent-grid { grid-template-columns: 1fr; gap: var(--space-5); }
    .about-agent-photo { width: 140px; height: 140px; }
  }
</style>
