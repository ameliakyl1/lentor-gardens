---
import { agent } from "@/data/agent";
import { project } from "@/data/project";

const whatsappUrl = `https://wa.me/${agent.whatsappNumber.replace(/[^\d]/g, "")}?text=${encodeURIComponent(
  project.contact.whatsappMessage
)}`;
---

<div class="mobile-contact-bar" role="navigation" aria-label="Quick contact">
  <a href={`tel:${agent.mobileNumber.replace(/\s/g, "")}`} class="bar-action" data-track="click_call">
    <span aria-hidden="true">📞</span>
    <span>Call</span>
  </a>
  <a
    href={whatsappUrl}
    class="bar-action"
    target="_blank"
    rel="noopener noreferrer"
    data-track="click_whatsapp"
  >
    <span class="bar-icon bar-icon-whatsapp" aria-hidden="true">
      <!-- Official WhatsApp glyph, used to identify the service this button opens. -->
      <svg viewBox="0 0 24 24" fill="currentColor" role="img" focusable="false">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
      </svg>
    </span>
    <span>WhatsApp</span>
  </a>
  <a href="#contact" class="bar-action bar-action-primary" data-track="book_showflat">
    <span>Book Showflat</span>
  </a>
</div>

<style>
  .mobile-contact-bar {
    display: none;
  }

  @media (max-width: 1240px) {
    .mobile-contact-bar {
      display: flex;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 90;
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
      box-shadow: var(--shadow-md);
      padding: var(--space-2) var(--space-3);
      padding-bottom: max(var(--space-2), env(safe-area-inset-bottom));
      gap: var(--space-2);
    }

    .bar-action {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      text-decoration: none;
      color: var(--color-ink);
      font-size: 0.78rem;
      font-weight: 600;
      min-height: 48px;
      border-radius: var(--radius-sm);
    }

    .bar-action span[aria-hidden] { font-size: 1.1rem; }
    .bar-icon { display: flex; align-items: center; justify-content: center; height: 1.1rem; }
    .bar-icon svg { width: 20px; height: 20px; display: block; }
    .bar-icon-whatsapp { color: #25d366; }

    .bar-action-primary {
      background: var(--color-accent);
      color: var(--color-on-accent);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>("[data-track]").forEach((el) => {
    el.addEventListener("click", () => {
      const eventName = el.dataset.track;
      if (!eventName) return;
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: eventName });
    });
  });
</script>
