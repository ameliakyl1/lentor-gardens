# Copy this file to .env and fill in real values before connecting live tracking / lead delivery.
# Never commit the real .env file. Never expose secret keys to client-side code —
# only PUBLIC_-prefixed variables are readable in the browser (Astro convention).

# --- Analytics & Ads tracking (placeholders — do not use real IDs until consent + QA is complete) ---
PUBLIC_GTM_ID=GTM-XXXXXXX
PUBLIC_GA4_ID=G-XXXXXXXXXX
PUBLIC_ADS_CONVERSION_ID=AW-XXXXXXXXX
PUBLIC_ADS_CONVERSION_LABEL=XXXXXXXXXXXXXXXXXXXX
PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXX

# --- Lead delivery (server-only secrets, never prefixed with PUBLIC_) ---
# Leave blank in development: submissions will be logged locally instead (see src/utils/leadAdapter.ts).
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
EMAIL_SERVICE_API_KEY=
NOTIFY_EMAIL_TO=amelialekera@gmail.com

# --- Form protection ---
FORM_RATE_LIMIT_WINDOW_SECONDS=60
FORM_RATE_LIMIT_MAX_SUBMISSIONS=3

# Cloudflare Turnstile (create a widget at dash.cloudflare.com -> Turnstile).
# PUBLIC_TURNSTILE_SITE_KEY is safe to expose client-side; TURNSTILE_SECRET_KEY is server-only.
# If TURNSTILE_SECRET_KEY is left blank, verification is skipped rather than blocking submissions.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
